{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disclosure Studio",
  "version": "0.1.0",
  "identifier": "studio.disclosure",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5178",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disclosure Studio",
        "width": 1200,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "all": false,
      "readFile": true,
      "writeFile": true,
      "readDir": true,
      "copyFile": true,
      "createDir": true,
      "removeFile": true,
      "removeDir": true,
      "renameFile": true,
      "exists": true
    },
    "dialog": {
      "all": false,
      "open": true,
      "save": true
    },
    "shell": {
      "all": false,
      "open": true
    }
  }
}